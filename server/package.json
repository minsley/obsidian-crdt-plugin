{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "y-websocket relay server with LevelDB persistence",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external && esbuild src/signaling.ts --bundle --platform=node --format=esm --outfile=dist/signaling.js --packages=external",
    "dev": "tsx --watch src/index.ts",
    "dev:signaling": "tsx --watch src/signaling.ts",
    "start": "node dist/index.js",
    "start:signaling": "node dist/signaling.js"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "y-websocket": "^2.0.0",
    "y-leveldb": "^0.1.2",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
