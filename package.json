{
  "name": "obsidian-crdt-coeditor",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time collaborative editing for Obsidian via Yjs CRDTs with LLM agent co-editing via MCP",
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:plugin": "npm run dev --workspace=plugin",
    "dev:sidecar": "npm run dev --workspace=sidecar"
  },
  "workspaces": [
    "plugin",
    "server",
    "sidecar"
  ],
  "overrides": {
    "yjs": "^13.6.0"
  },
  "pnpm": {
    "overrides": {
      "yjs": "^13.6.0"
    }
  }
}
